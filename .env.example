THINC_DATABASE_URL=postgresql+psycopg://thinc_app:change-me-app@localhost:5432/thinc
# Use this URL for non-test Alembic commands; do not combine it with a
# different THINC_TEST_DATABASE_URL in the same non-explicit Alembic process.
THINC_MIGRATION_DATABASE_URL=postgresql+psycopg://thinc_migrator:change-me-migration@localhost:5432/thinc
THINC_TEST_DATABASE_URL=postgresql+psycopg://thinc_migrator:change-me-migration@localhost:5432/thinc_test
THINC_TEST_APP_DATABASE_URL=postgresql+psycopg://thinc_app:change-me-app@localhost:5432/thinc_test
THINC_TEST_PROVISIONER_DATABASE_URL=postgresql+psycopg://postgres:change-me-admin@localhost:5432/thinc_test
THINC_TEST_DATABASE_DISPOSABLE=0
THINC_ENVIRONMENT=development
